   "source": [
    "from tkinter import *\n",
    "from tkinter.colorchooser import askcolor\n",
    "\n",
    "win = Tk()\n",
    "def color():\n",
    "    ans = askcolor(title=\"python\")\n",
    "    win.config(bg=ans[1])\n",
    "\n",
    "\n",
    "button = Button(win,text=\"ok\",command=color)\n",
    "button.place(x=20,y=20,height=50,width=50)\n",
    "\n",
    "win.mainloop()"
   ]
  },
