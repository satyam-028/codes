   "source": [
    "from tkinter import *\n",
    "\n",
    "win = Tk()\n",
    "\n",
    "win.title(\"***  Satyam Sharma  ***\") ## give a title on top \n",
    "\n",
    "win.attributes('-alpha',1) ## transparent the window\n",
    "\n",
    "# win.config(bg=\"red\") ## change background color \n",
    "win['bg']=\"black\" ## change background color \n",
    "\n",
    "\n",
    "win.mainloop()"
   ]
